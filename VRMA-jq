<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#4F46E5">
<meta name="format-detection" content="telephone=no">
<title>金桥校区单词速记考核</title>
<style>
  :root{
    --primary:#4F46E5; --primary-dark:#4338CA; --primary-soft:#EEF0FF;
    --bg:#F5F6FB; --card:#FFFFFF; --line:#E6E8F0;
    --text:#1C2033; --muted:#7A8199; --sub:#4A5169;
    --ok:#16A34A; --ok-soft:#E9F9EF; --bad:#DC2626; --bad-soft:#FDEDED;
    --warn:#D97706; --warn-soft:#FFF6E6;
    --shadow:0 8px 30px rgba(35,42,85,.07); --shadow-lg:0 16px 48px rgba(35,42,85,.12);
    --r:18px;
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  html,body{margin:0;padding:0}
  html{-webkit-text-size-adjust:100%;text-size-adjust:100%}
  body{
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;
    background:var(--bg); color:var(--text); line-height:1.6; min-height:100vh; overflow-x:hidden;
  }
  button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit;touch-action:manipulation}
  button:disabled{cursor:not-allowed}
  .wrap{max-width:880px;margin:0 auto;padding:0 20px 60px}

  /* ---------- header ---------- */
  header{
    background:linear-gradient(120deg,#4F46E5 0%,#6D5DF6 55%,#8B5CF6 100%);
    color:#fff;padding:30px 0 32px;margin-bottom:26px;text-align:center;
  }
  .head-inner{max-width:880px;margin:0 auto;padding:0 20px;display:flex;align-items:center;justify-content:center}
  .head-txt h1{
    margin:0;font-size:20px;font-size:clamp(19px,2.4vw,25px);font-weight:800;
    letter-spacing:.4px;letter-spacing:clamp(1px,.35vw,3px);line-height:1.35;
    text-shadow:0 1px 3px rgba(43,25,120,.22)
  }
  .head-txt h1::after{
    content:'';display:block;width:64px;height:2px;border-radius:2px;margin:11px auto 0;
    background:linear-gradient(90deg,rgba(255,255,255,.15),rgba(255,255,255,.72),rgba(255,255,255,.15))
  }

  /* ---------- generic ---------- */
  .card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow);padding:26px;margin-bottom:18px}
  .card h2{margin:0 0 4px;font-size:16.5px;font-weight:750;display:flex;align-items:center;gap:9px}
  .card .desc{margin:0 0 18px;font-size:13px;color:var(--muted)}
  .step{
    width:23px;height:23px;border-radius:8px;background:var(--primary-soft);color:var(--primary);
    font-size:12.5px;font-weight:800;display:grid;place-items:center;flex:none
  }
  .btn{
    display:inline-flex;align-items:center;justify-content:center;gap:7px;
    padding:10px 17px;border-radius:11px;font-size:13.5px;font-weight:650;
    background:#F1F2F8;color:var(--sub);transition:.16s;border:1px solid transparent
  }
  .btn:hover{background:#E8EAF4;transform:translateY(-1px)}
  .btn.primary{background:var(--primary);color:#fff;box-shadow:0 6px 16px rgba(79,70,229,.25)}
  .btn.primary:hover{background:var(--primary-dark)}
  .btn.ghost{background:#fff;border-color:var(--line);color:var(--sub)}
  .btn.ghost:hover{background:#F7F8FC}
  .btn:disabled{opacity:.45;transform:none;box-shadow:none}
  .btn.big{padding:15px 22px;font-size:15px;border-radius:13px;width:100%}
  .row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
  .hidden{display:none !important}

  /* ---------- setup ---------- */
  .sets{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .set-card{
    position:relative;display:flex;flex-direction:column;gap:5px;text-align:left;
    border:1.5px solid var(--line);border-radius:14px;background:#fff;padding:16px 44px 15px 16px;
    transition:.16s
  }
  .set-card:hover{border-color:#BFC4F5;transform:translateY(-1px);box-shadow:var(--shadow)}
  .set-card.on{border-color:var(--primary);background:linear-gradient(180deg,#F4F3FF 0%,#fff 82%);box-shadow:0 0 0 3px rgba(79,70,229,.09)}
  .set-card .set-name{font-size:14.5px;font-weight:750;letter-spacing:.2px;line-height:1.4;color:var(--text)}
  .set-card .set-meta{font-size:12px;color:var(--muted)}
  .set-card .set-radio{
    position:absolute;right:15px;top:50%;transform:translateY(-50%);
    width:19px;height:19px;border-radius:50%;border:1.5px solid #CFD3E6;transition:.16s
  }
  .set-card.on .set-radio{background:var(--primary);border-color:var(--primary);box-shadow:inset 0 0 0 4px #fff}
  .set-foot{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:14px;font-size:11.5px;color:var(--muted)}
  .set-foot .dot{width:5px;height:5px;border-radius:50%;background:var(--primary);flex:none}
  .set-foot .now{margin-left:auto;font-weight:650;color:var(--sub)}
  .hint{font-size:12px;color:var(--muted);margin-top:10px;line-height:1.7}

  .field-label{font-size:12.5px;font-weight:650;color:var(--sub);margin-bottom:8px;display:block}
  .count-row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
  input[type=number]{
    width:112px;padding:10px 12px;border:1px solid var(--line);border-radius:10px;
    font-size:15px;font-weight:700;color:var(--text);outline:none;background:#FCFCFE
  }
  input[type=number]:focus{border-color:var(--primary);box-shadow:0 0 0 3px var(--primary-soft)}
  .chip{padding:7px 12px;border-radius:9px;background:#F1F2F8;font-size:12.5px;font-weight:650;color:var(--sub)}
  .chip:hover{background:var(--primary-soft);color:var(--primary)}
  .chip.on{background:var(--primary);color:#fff}

  .modes{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .mode{
    border:1.5px solid var(--line);border-radius:14px;padding:16px;text-align:left;transition:.16s;background:#fff;position:relative
  }
  .mode:hover{border-color:#BFC4F5;transform:translateY(-1px)}
  .mode.on{border-color:var(--primary);background:var(--primary-soft);box-shadow:0 0 0 3px rgba(79,70,229,.09)}
  .mode .top{display:flex;align-items:center;gap:8px;font-size:15px;font-weight:750;margin-bottom:6px}
  .mode .badge{font-size:10.5px;padding:2px 8px;border-radius:99px;background:#EAF7EE;color:var(--ok);font-weight:700}
  .mode:nth-child(2) .badge{background:#EEF0FF;color:var(--primary)}
  .mode p{margin:0;font-size:12px;color:var(--sub);line-height:1.75}
  .mode .tick{position:absolute;right:14px;top:14px;width:17px;height:17px;border-radius:50%;border:1.5px solid #CFD3E6}
  .mode.on .tick{background:var(--primary);border-color:var(--primary);box-shadow:inset 0 0 0 4px #fff}
  .switch-row{display:flex;align-items:center;gap:10px;margin-top:16px;font-size:13px;color:var(--sub)}
  .switch{width:40px;height:23px;border-radius:99px;background:#D8DBE9;position:relative;transition:.18s;flex:none}
  .switch::after{content:"";position:absolute;width:17px;height:17px;border-radius:50%;background:#fff;left:3px;top:3px;transition:.18s;box-shadow:0 1px 3px rgba(0,0,0,.15)}
  .switch.on{background:var(--primary)}
  .switch.on::after{left:20px}

  .resume{
    display:flex;align-items:center;gap:12px;background:#FFF9EC;border:1px solid #F5E3BE;
    color:#8A5B0B;border-radius:13px;padding:13px 16px;margin-bottom:18px;font-size:13px
  }
  .resume .btn{margin-left:auto;padding:8px 14px;background:#fff;border-color:#F0D9A8;color:#8A5B0B;font-size:12.5px}

  /* ---------- quiz ---------- */
  .qbar{display:flex;align-items:center;gap:14px;margin-bottom:16px;flex-wrap:wrap}
  .qbar .prog{font-size:13px;font-weight:750;white-space:nowrap}
  .qbar .prog span{color:var(--primary);font-size:17px}
  .track{flex:1;min-width:120px;height:8px;border-radius:99px;background:#E6E8F2;overflow:hidden}
  .track i{display:block;height:100%;border-radius:99px;background:linear-gradient(90deg,#4F46E5,#8B5CF6);transition:width .3s ease}
  .stat{font-size:12.5px;color:var(--muted);white-space:nowrap}
  .stat b{color:var(--text);font-size:14px}
  .qcard{text-align:center;padding:34px 26px 28px;position:relative}
  .mode-pill{
    display:inline-block;font-size:11.5px;font-weight:700;padding:4px 11px;border-radius:99px;
    background:var(--primary-soft);color:var(--primary);margin-bottom:16px
  }
  .mode-pill.easy{background:#EAF7EE;color:var(--ok)}
  .word{font-size:clamp(34px,7vw,54px);font-weight:800;letter-spacing:-1.2px;line-height:1.15;word-break:break-word;margin:0 0 6px}
  .qtip{font-size:13px;color:var(--muted);margin-bottom:14px}
  .tip-text{
    display:inline-block;background:var(--warn-soft);color:var(--warn);border:1px solid #F7E2BC;
    padding:7px 14px;border-radius:10px;font-size:13px;font-weight:650;letter-spacing:.6px;margin-bottom:6px
  }
  .tools{display:flex;justify-content:center;gap:8px;flex-wrap:wrap;margin-top:4px}
  .tool{
    padding:7px 13px;border-radius:9px;border:1px solid var(--line);background:#fff;
    font-size:12.5px;font-weight:650;color:var(--sub)
  }
  .tool:hover{background:var(--primary-soft);border-color:#CFD3F8;color:var(--primary)}
  .tool:disabled{opacity:.4}

  .options{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:22px}
  .opt{
    display:flex;align-items:center;gap:12px;text-align:left;padding:16px 16px;border:1.5px solid var(--line);
    border-radius:13px;background:#fff;font-size:15px;font-weight:600;color:var(--text);transition:.14s;min-height:62px
  }
  .opt:hover:not(:disabled){border-color:var(--primary);background:var(--primary-soft);transform:translateY(-1px)}
  .opt .k{
    width:27px;height:27px;border-radius:8px;background:#F1F2F8;color:var(--sub);font-size:12.5px;
    font-weight:800;display:grid;place-items:center;flex:none
  }
  .opt.correct{border-color:var(--ok);background:var(--ok-soft);color:#0F6B32}
  .opt.correct .k{background:var(--ok);color:#fff}
  .opt.wrong{border-color:var(--bad);background:var(--bad-soft);color:#A91D1D}
  .opt.wrong .k{background:var(--bad);color:#fff}
  .opt.dim{opacity:.35}
  .opt.elim{opacity:.3;text-decoration:line-through;background:#F6F6F9}
  .opt:disabled{opacity:1}

  .feedback{margin-top:18px;border-radius:12px;padding:13px 16px;font-size:13.5px;font-weight:650;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
  .feedback.ok{background:var(--ok-soft);color:#0F6B32}
  .feedback.bad{background:var(--bad-soft);color:#A91D1D}
  .feedback.retry{background:var(--warn-soft);color:var(--warn)}
  .feedback .btn{margin-left:auto;padding:8px 15px;font-size:12.5px;background:#fff}
  .kbd{font-size:11px;color:var(--muted);font-weight:500}

  /* ---------- result ---------- */
  .score-wrap{text-align:center;padding:32px 20px 26px}
  .ring{
    width:158px;height:158px;border-radius:50%;margin:0 auto 18px;display:grid;place-items:center;
    background:conic-gradient(var(--primary) calc(var(--p)*1%),#E9EBF4 0);position:relative
  }
  .ring::after{content:"";position:absolute;width:126px;height:126px;border-radius:50%;background:#fff}
  .ring .in{position:relative;z-index:1;line-height:1.15}
  .ring .num{font-size:38px;font-weight:800;letter-spacing:-1.5px}
  .ring .num small{font-size:17px;font-weight:700}
  .ring .lb{font-size:11.5px;color:var(--muted);margin-top:2px}
  .verdict{font-size:19px;font-weight:750;margin:0 0 4px}
  .verdict-sub{font-size:13px;color:var(--muted);margin:0 0 20px}
  .nums{display:flex;justify-content:center;gap:0;border:1px solid var(--line);border-radius:13px;overflow:hidden;max-width:430px;margin:0 auto}
  .nums div{flex:1;padding:13px 8px;border-right:1px solid var(--line)}
  .nums div:last-child{border-right:none}
  .nums b{display:block;font-size:20px;font-weight:800}
  .nums span{font-size:11.5px;color:var(--muted)}
  .extra{font-size:12.5px;color:var(--sub);margin-top:14px}
  .extra b{color:var(--primary)}

  .wrong-head{display:flex;align-items:center;gap:10px;margin-bottom:12px}
  .wrong-head h3{margin:0;font-size:15px;font-weight:750}
  .wrong-head span{font-size:12px;color:var(--muted)}
  .wrong-head .btn{margin-left:auto}
  table{width:100%;border-collapse:collapse;font-size:13px}
  th,td{text-align:left;padding:10px 8px;border-bottom:1px solid #F0F1F6;vertical-align:top}
  th{font-size:11.5px;color:var(--muted);font-weight:650;background:#FAFBFE}
  td.en{font-weight:700;white-space:nowrap}
  td.mine{color:var(--bad)}
  td.right{color:var(--ok);font-weight:650}
  tr:last-child td{border-bottom:none}
  .empty{text-align:center;color:var(--muted);font-size:13px;padding:22px 0}
  .footer-note{text-align:center;font-size:11.5px;color:#A0A6BA;margin-top:22px;line-height:1.8}
  .copyright{text-align:center;font-size:11.5px;color:#A8AEC2;letter-spacing:.3px;margin-top:12px}

  @media (max-width:640px){
    .wrap{padding:0 14px 40px}
    header{padding:24px 0 26px}
    .head-inner{padding:0 14px}
    input[type=number]{font-size:16px}
    .card{padding:19px 16px}
    .sets{grid-template-columns:1fr}
    .modes{grid-template-columns:1fr}
    .options{grid-template-columns:1fr;gap:9px}
    .opt{min-height:54px;padding:13px 14px;font-size:14.5px}
    .qcard{padding:26px 14px 22px}
    th:nth-child(3),td:nth-child(3){display:none}
  }
</style>
</head>
<body>

<header>
  <div class="head-inner">
    <div class="head-txt">
      <h1 id="appTitle">金桥校区单词速记考核</h1>
    </div>
  </div>
</header>

<div class="wrap">

  <!-- ============ SETUP ============ -->
  <section id="viewSetup">
    <div class="resume hidden" id="resumeBox">
      <div>📌 上次有一组测试还没做完（<b id="resumeInfo">—</b>），可以继续答。</div>
      <button class="btn" id="btnResume">继续答题</button>
      <button class="btn" id="btnDiscard">丢弃</button>
    </div>

    <div class="card">
      <h2><span class="step">1</span> 选择词库</h2>
      <p class="desc">已内置 <b id="setCount">4</b> 套词库（合计 <b id="builtinCount">—</b> 词），点选一套即可开始抽题。</p>
      <div class="sets" id="setGrid"></div>
      <div class="set-foot">
        <span class="dot"></span>
        <span>切换词库会重新开始一组题</span>
        <span class="now" id="setNow">—</span>
      </div>
    </div>

    <div class="card">
      <h2><span class="step">2</span> 出题设置</h2>
      <p class="desc">从词库里随机抽题，每次顺序和干扰项都会重新打乱。</p>

      <label class="field-label">抽取题数</label>
      <div class="count-row">
        <input type="number" id="countInput" value="300" min="1" max="9999">
        <span style="font-size:12.5px;color:var(--muted)">题</span>
        <button class="chip" data-count="100">100</button>
        <button class="chip" data-count="200">200</button>
        <button class="chip on" data-count="300">300</button>
        <button class="chip" data-count="all">全部</button>
        <span id="vocabSize" style="font-size:12px;color:var(--muted);margin-left:auto">词库 0 词</span>
      </div>
      <div class="hint" id="countHint">默认 300 题；若词库不足 300 词，会自动按词库上限出题。</div>

      <label class="field-label" style="margin-top:22px">难度模式</label>
      <div class="modes">
        <button class="mode" data-mode="easy">
          <span class="tick"></span>
          <div class="top">🌱 简单模式 <span class="badge">带辅助</span></div>
          <p>干扰项避开形近词，可用「提示首字母 / 排除错误项 / 朗读」；第一次选错还给一次重选机会，不限时、不计时。适合低年级或初学词表。</p>
        </button>
        <button class="mode on" data-mode="normal">
          <span class="tick"></span>
          <div class="top">🎯 正常模式 <span class="badge">标准测评</span></div>
          <p>无任何提示，优先挑词形相近的词做干扰项，一次作答即判定，全程计时。用于正式测评和正确率统计。</p>
        </button>
      </div>

      <div class="switch-row">
        <div class="switch on" id="autoSwitch"></div>
        <span>答完自动进入下一题（0.9 秒）</span>
        <span style="color:var(--muted);font-size:12px">关闭后按空格 / 回车手动翻页</span>
      </div>
    </div>

    <button class="btn primary big" id="btnStart">开始测评 →</button>
    <div class="copyright">此考核系统最终解释权归锐思教育金桥校区所有</div>
  </section>

  <!-- ============ QUIZ ============ -->
  <section id="viewQuiz" class="hidden">
    <div class="qbar">
      <div class="prog"><span id="qNow">1</span> / <span id="qTotal">300</span></div>
      <div class="track"><i id="qTrack" style="width:0%"></i></div>
      <div class="stat">正确率 <b id="qAcc">—</b></div>
      <div class="stat hidden" id="qTimeBox">⏱ <b id="qTime">00:00</b></div>
      <button class="btn ghost" id="btnQuit" style="padding:7px 12px;font-size:12px">结束</button>
    </div>

    <div class="card qcard">
      <div class="mode-pill easy" id="qModePill">🌱 简单模式</div>
      <div class="word" id="qWord">—</div>
      <div class="qtip">选出正确的中文释义</div>
      <div id="tipBox" class="hidden"><span class="tip-text" id="tipText"></span></div>
      <div class="tools">
        <button class="tool" id="btnSpeak">🔊 朗读</button>
        <span id="easyTools" class="row" style="gap:8px">
          <button class="tool" id="btnHint">💡 提示</button>
          <button class="tool" id="btnElim">✂️ 排除一个</button>
        </span>
      </div>
      <div class="options" id="options"></div>
      <div class="feedback hidden" id="feedback"></div>
    </div>
    <div class="footer-note">答题进度会自动保存，中途关掉页面回来可以接着答。</div>
  </section>

  <!-- ============ RESULT ============ -->
  <section id="viewResult" class="hidden">
    <div class="card score-wrap">
      <div class="ring" id="ring" style="--p:0"><div class="in"><div class="num" id="scoreNum">0<small>%</small></div><div class="lb">正确率</div></div></div>
      <p class="verdict" id="verdict">—</p>
      <p class="verdict-sub" id="verdictSub">—</p>
      <div class="nums">
        <div><b id="nRight" style="color:var(--ok)">0</b><span>答对</span></div>
        <div><b id="nWrong" style="color:var(--bad)">0</b><span>答错</span></div>
        <div><b id="nTotal">0</b><span>总题数</span></div>
        <div><b id="nTime">00:00</b><span>用时</span></div>
      </div>
      <div class="extra" id="extraLine"></div>
    </div>

    <div class="card">
      <div class="wrong-head">
        <h3>错题本</h3><span id="wrongCount">0 个</span>
        <button class="btn ghost" id="btnExport" style="padding:7px 12px;font-size:12px">导出 CSV</button>
      </div>
      <div id="wrongTable"></div>
    </div>

    <div class="row">
      <button class="btn primary" id="btnRedoWrong" style="flex:1">只重做错题</button>
      <button class="btn" id="btnAgain" style="flex:1">重新抽一组</button>
      <button class="btn ghost" id="btnBack" style="flex:1">返回设置</button>
    </div>
    <div class="footer-note">错题导出可直接用 Excel 打开，方便整理成课后复习清单。</div>
  </section>

</div>

<script>
/* =========================================================
   金桥校区单词速记考核  —— 单文件离线版
   ========================================================= */
const $ = s => document.querySelector(s);
