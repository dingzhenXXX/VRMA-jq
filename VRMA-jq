/* ---------- utils ---------- */
function escapeHTML(s){
  return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
function shuffle(arr){
  const a = arr.slice();
  for(let i=a.length-1;i>0;i--){ const j = Math.floor(Math.random()*(i+1)); [a[i],a[j]]=[a[j],a[i]]; }
  return a;
}
function fmtTime(sec){
  sec = Math.max(0, Math.floor(sec));
  const m = Math.floor(sec/60), s = sec%60;
  return String(m).padStart(2,'0')+':'+String(s).padStart(2,'0');
}
function show(view){
  ['Setup','Quiz','Result'].forEach(v => $('#view'+v).classList.toggle('hidden', v!==view));
  window.scrollTo({top:0,behavior:'smooth'});
}
function save(key, val){
  try{ localStorage.setItem(key, JSON.stringify(val)); }catch(e){}
}
function load(key){
  try{ const v = localStorage.getItem(key); return v ? JSON.parse(v) : null; }catch(e){ return null; }
}
function clearSave(key){
  try{ localStorage.removeItem(key); }catch(e){}
}
function speak(word){
  try{
    if(!('speechSynthesis' in window)) return;
    speechSynthesis.cancel();
    const u = new SpeechSynthesisUtterance(word);
    u.lang = 'en-US'; u.rate = .85;
    speechSynthesis.speak(u);
  }catch(e){}
}

/* ---------- count limit ---------- */
function applyCountLimit(){
  const n = vocab.length || 1;
  const input = $('#countInput');
  if(Number(input.value) > n) input.value = n;
  $('#countHint').textContent = vocab.length && vocab.length < 300
    ? '当前词库只有 '+vocab.length+' 词，将按词库上限出题；导入完整词表后即可抽满 300 题。'
    : '默认 300 题；若词库不足 300 词，会自动按词库上限出题。';
}

/* ---------- build questions ---------- */
function buildQuestions(pool, count, mode){
  const all = pool.slice();
  const uniqZh = new Set(all.map(x=>x.zh));
  const picked = shuffle(all).slice(0, Math.min(count, all.length));
  const questions = [];
  for(const item of picked){
    const sameZh = x => x.zh === item.zh || x.en.toLowerCase() === item.en.toLowerCase();
    let candidates = all.filter(x => !sameZh(x));
    let distractors = [];
    const usedZh = new Set([item.zh]);
    const preferred = mode === 'normal'
      // 正常模式：优先挑词形相近的，提高迷惑度
      ? shuffle(candidates.filter(x =>
          x.en[0].toLowerCase() === item.en[0].toLowerCase() ||
          Math.abs(x.en.length - item.en.length) <= 1
        ))
      // 简单模式：避开形近词、避开中文首字相同
      : shuffle(candidates.filter(x =>
          x.en[0].toLowerCase() !== item.en[0].toLowerCase() &&
          Math.abs(x.en.length - item.en.length) > 1 &&
          x.zh[0] !== item.zh[0]
        ));
    // 按中文释义去重后再选：词库里「同义不同词」的条目不能同时出现在四个选项里
    for(const x of preferred){
      if(distractors.length >= 3) break;
      if(usedZh.has(x.zh)) continue;
      distractors.push(x); usedZh.add(x.zh);
    }
    if(distractors.length < 3){
      for(const x of shuffle(candidates)){
        if(distractors.length >= 3) break;
        if(usedZh.has(x.zh)) continue;
        distractors.push(x); usedZh.add(x.zh);
      }
    }
    const opts = shuffle([item.zh, ...distractors.slice(0,3).map(x=>x.zh)]);
    questions.push({
      en: item.en, answer: item.zh, options: opts,
      correct: opts.indexOf(item.zh),
      status: null, chosen: null, secondChance: false, eliminated: [], hintUsed: false
    });
  }
  return questions;
}

/* ---------- quiz flow ---------- */
function startQuiz(questions, mode, autoNext, label){
  session = {
    questions, mode, autoNext, label, setLabel: currentSet().label,
    idx: 0, right: 0, saved: 0, wrong: 0,
    startAt: Date.now(), elapsed: 0, done: false
  };
  save(KEY_SESSION, session);
  enterQuiz();
}
function enterQuiz(){
  clearInterval(timerId);
  show('Quiz');
  $('#qTotal').textContent = session.questions.length;
  $('#qModePill').textContent = session.mode === 'easy' ? '🌱 简单模式' : '🎯 正常模式';
  $('#qModePill').classList.toggle('easy', session.mode==='easy');
  $('#easyTools').classList.toggle('hidden', session.mode!=='easy');
  $('#qTimeBox').classList.toggle('hidden', session.mode!=='normal');
  if(session.mode === 'normal'){
    timerId = setInterval(()=>{
      session.elapsed = Math.floor((Date.now()-session.startAt)/1000);
      $('#qTime').textContent = fmtTime(session.elapsed);
    }, 500);
  }
  renderQuestion();
}
function current(){ return session.questions[session.idx]; }

function renderQuestion(){
  clearTimeout(autoTimer);
  locked = false;
  const q = current();
  const isEasy = session.mode === 'easy';
  $('#qNow').textContent = session.idx+1;
  $('#qTrack').style.width = (session.idx/session.questions.length*100)+'%';
  $('#qAcc').textContent = session.idx ? Math.round(session.right/session.idx*100)+'%' : '—';
  $('#qWord').textContent = q.en;
  $('#tipBox').classList.add('hidden');
  $('#feedback').className = 'feedback hidden';
  $('#feedback').innerHTML = '';
  $('#btnHint').disabled = false;
  $('#btnElim').disabled = false;
  $('#btnHint').textContent = '💡 提示';
  $('#btnElim').textContent = '✂️ 排除一个';

  const dead = i => q.eliminated.includes(i) || (isEasy && q.secondChance && !q.status && q.firstWrong === i);
  $('#options').innerHTML = q.options.map((o,i)=>
    '<button class="opt'+(q.eliminated.includes(i)?' elim':'')+(dead(i) && !q.eliminated.includes(i)?' wrong dim':'')+'" data-i="'+i+'"'+(dead(i)?' disabled':'')+'>'+
      '<span class="k">'+'ABCD'[i]+'</span><span>'+escapeHTML(o)+'</span></button>'
  ).join('');
  $$('#options .opt').forEach(btn => btn.addEventListener('click', ()=>choose(Number(btn.dataset.i))));
  if(isEasy && q.hintUsed){ showHint(); $('#btnHint').textContent='💡 已提示'; $('#btnHint').disabled=true; }
  if(q.eliminated.length){
    $('#btnElim').textContent='✂️ 已排除 '+q.eliminated.length+'/2';
    if(q.eliminated.length>=2) $('#btnElim').disabled=true;
  }
}

function choose(i){
  if(locked || !session || session.done) return;
  const q = current();
  if(q.status) return;
  const ok = (i === q.correct);
  const btns = $$('#options .opt');
  const isEasy = session.mode === 'easy';

  if(ok){
    q.status = q.secondChance ? 'saved' : 'right';
    q.chosen = i;
    if(q.status === 'right') session.right++; else session.saved++;
    locked = true;
    btns[i].classList.add('correct');
    btns.forEach((b,j)=>{ if(j!==i) b.classList.add('dim'); b.disabled=true; });
    showFeedback('ok', q.status === 'right' ? '✅ 回答正确！' : '✅ 第二次答对了，记入「补救答对」。');
  }else if(isEasy && !q.secondChance){
    // 简单模式：给一次重选机会
    q.secondChance = true;
    q.firstWrong = i;
    btns[i].classList.add('wrong','dim');
    btns[i].disabled = true;
    showFeedback('retry', '再想想～ 还有一次机会（本题最多排除两个错误项）');
  }else{
    q.status = 'wrong'; q.chosen = i; session.wrong++;
    locked = true;
    btns[i].classList.add('wrong');
    btns[q.correct].classList.add('correct');
    btns.forEach(b=>b.disabled=true);
    showFeedback('bad', '❌ 正确答案：<b>'+escapeHTML(q.answer)+'</b>');
  }
  save(KEY_SESSION, session);
}

function showFeedback(kind, msg){
  const fb = $('#feedback');
  fb.className = 'feedback '+kind;
  const last = session.idx === session.questions.length-1;
  fb.innerHTML = '<span>'+msg+'</span>'+
    '<button class="btn" id="btnNext">'+(last?'查看成绩 →':'下一题 →')+'</button>'+
    '<span class="kbd">空格 / 回车</span>';
  $('#btnNext').addEventListener('click', nextQuestion);
  if(session.autoNext && (kind !== 'retry')){
    autoTimer = setTimeout(nextQuestion, 900);
  }
}
function showHint(){
  const q = current();
  q.hintUsed = true;
  const w = q.en;
  $('#tipText').textContent = '首字母 '+w[0].toUpperCase()+' · 共 '+w.replace(/\s/g,'').length+' 个字母 · 结尾 '+w[w.length-1];
  $('#tipBox').classList.remove('hidden');
  save(KEY_SESSION, session);
}
function eliminateOne(){
  const q = current();
  if(q.status || locked) return;
  const maxElim = session.mode === 'easy' ? 2 : 0;
  if(maxElim === 0) return;
  const wrongIdx = q.options.map((o,i)=>i).filter(i => i!==q.correct && !q.eliminated.includes(i));
  if(!wrongIdx.length || q.eliminated.length >= maxElim) return;
  const pick = wrongIdx[Math.floor(Math.random()*wrongIdx.length)];
  q.eliminated.push(pick);
  const btn = $$('#options .opt')[pick];
  if(btn){ btn.classList.add('elim'); btn.disabled = true; }
  $('#btnElim').textContent = '✂️ 已排除 '+q.eliminated.length+'/2';
  if(q.eliminated.length >= maxElim) $('#btnElim').disabled = true;
  save(KEY_SESSION, session);
}
function nextQuestion(){
  if(!session || session.done) return;
  clearTimeout(autoTimer);
  if(session.idx >= session.questions.length-1){ finishQuiz(); return; }
  session.idx++;
  save(KEY_SESSION, session);
  renderQuestion();
}
function finishQuiz(){
  clearInterval(timerId); clearTimeout(autoTimer);
  session.elapsed = session.mode === 'normal' ? Math.floor((Date.now()-session.startAt)/1000) : session.elapsed;
  session.done = true;
  save(KEY_SESSION, session);
  renderResult();
  show('Result');
}

/* ---------- result ---------- */
function renderResult(){
  const qs = session.questions;
  const answered = qs.filter(q=>q.status).length || 1;
  const acc = Math.round(session.right/answered*100);
  const total = session.right + session.saved + session.wrong;
  const finalAcc = total ? Math.round((session.right+session.saved)/total*100) : 0;
  $('#ring').style.setProperty('--p', acc);
  $('#scoreNum').innerHTML = acc+'<small>%</small>';
  $('#nRight').textContent = session.right;
  $('#nWrong').textContent = session.saved + session.wrong;
  $('#nTotal').textContent = qs.length;
  $('#nTime').textContent = session.mode==='normal' ? fmtTime(session.elapsed) : '不限时';
  const v = acc>=90 ? ['太稳了！','这份词表基本过关，可以上难度或换新词了。']
          : acc>=75 ? ['掌握得不错','再过一遍错题就很扎实了。']
          : acc>=60 ? ['还得再练练','建议先把下面的错题重做一遍。']
          : ['先回炉一轮','别急，把错题抄一遍再测，提升会很明显。'];
  $('#verdict').textContent = v[0];
  $('#verdictSub').textContent = v[1]+'（'+(session.setLabel||currentSet().label)+' · '+(session.mode==='easy'?'简单模式':'正常模式')+' · '+qs.length+' 题）';
  let extra = '';
  if(session.mode === 'easy' && session.saved){
    extra = '简单模式下有 <b>'+session.saved+'</b> 题是第二次才答对；把「补救答对」也算上的最终正确率是 <b>'+finalAcc+'%</b>。';
  }else if(session.mode === 'easy'){
    extra = '简单模式：所有答对的题都是一次选中，没有使用第二次机会。';
  }else{
    extra = '正常模式：一次作答即判定，正确率即为最终成绩。';
  }
  $('#extraLine').innerHTML = extra;

  const wrongs = qs.filter(q=>q.status==='wrong' || q.status==='saved');
  $('#wrongCount').textContent = wrongs.length+' 个';
  $('#btnRedoWrong').disabled = !wrongs.length;
  if(!wrongs.length){
    $('#wrongTable').innerHTML = '<div class="empty">🎉 全对，没有错题！</div>';
  }else{
    $('#wrongTable').innerHTML = '<table><thead><tr><th>单词</th><th>你的选择</th><th>正确答案</th><th>标记</th></tr></thead><tbody>'+
      wrongs.map(q=>'<tr><td class="en">'+escapeHTML(q.en)+'</td>'+
        '<td class="mine">'+escapeHTML(q.options[q.chosen]||'—')+'</td>'+
        '<td class="right">'+escapeHTML(q.answer)+'</td>'+
        '<td>'+(q.status==='saved'?'二次答对':'答错')+'</td></tr>').join('')+
      '</tbody></table>';
  }
  $('#btnExport').disabled = !wrongs.length;
}

function exportWrong(){
  const wrongs = session.questions.filter(q=>q.status==='wrong'||q.status==='saved');
  if(!wrongs.length) return;
  const esc = s => '"'+String(s).replace(/"/g,'""')+'"';
  const csv = '\uFEFF'+['英文','你的选择','正确答案','结果'].map(esc).join(',')+'\n'+
    wrongs.map(q=>[q.en,q.options[q.chosen]||'',q.answer,q.status==='saved'?'二次答对':'答错'].map(esc).join(',')).join('\n');
  const blob = new Blob([csv],{type:'text/csv;charset=utf-8'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = '单词错题_'+new Date().toISOString().slice(0,10)+'.csv';
  a.click();
  setTimeout(()=>URL.revokeObjectURL(a.href), 1000);
}
/* ---------- setup interactions ---------- */
function setMode(m){
  config.mode = m;
  $$('.mode').forEach(b=>b.classList.toggle('on', b.dataset.mode===m));
  save(KEY_CFG, config);
}
function setCount(n){
  config.count = n;
  $('#countInput').value = (n === 'all') ? (vocab.length || 300) : n;
  $$('.chip').forEach(c=>c.classList.toggle('on', c.dataset.count===String(n)));
  save(KEY_CFG, config);
}
function checkResume(){
  const s = load(KEY_SESSION);
  if(s && !s.done && s.questions && s.questions.length && s.idx < s.questions.length){
    $('#resumeBox').classList.remove('hidden');
    $('#resumeInfo').textContent = '第 '+(s.idx+1)+'/'+s.questions.length+' 题';
  }else{
    $('#resumeBox').classList.add('hidden');
  }
}
function startFromSetup(){
  if(!vocab.length) vocab = currentSet().data.slice();
  if(new Set(vocab.map(x=>x.zh)).size < 4){
    alert('词表里不同的中文释义不足 4 条，无法组成四选一。请补充词表后再开始。');
    return;
  }
  let n = parseInt($('#countInput').value, 10);
  if(!n || n < 1) n = 1;
  n = Math.min(n, vocab.length);
  config.count = n; config.mode = config.mode; save(KEY_CFG, config);
  const qs = buildQuestions(vocab, n, config.mode);
  startQuiz(qs, config.mode, config.autoNext, '随机抽题');
}

/* ---------- events ---------- */
let currentSetId = 'ab';
function currentSet(){
  return VOCAB_SETS.find(s=>s.id===currentSetId) || VOCAB_SETS[0];
}
function applySet(id){
  const set = VOCAB_SETS.find(s=>s.id===id) || VOCAB_SETS[0];
  currentSetId = set.id;
  save(KEY_SET, set.id);
  vocab = set.data.slice();
  $('#vocabSize').textContent = '词库 '+vocab.length+' 词';
  $('#setNow').textContent = '当前：'+set.label+' · '+vocab.length+' 词';
  $$('.set-card').forEach(b=>b.classList.toggle('on', b.dataset.set===set.id));
  clearSave(KEY_SESSION);
  $('#resumeBox').classList.add('hidden');
  applyCountLimit();
}
function renderSetGrid(){
  $('#setGrid').innerHTML = VOCAB_SETS.map(s=>
    '<button class="set-card" data-set="'+s.id+'">'+
      '<span class="set-radio"></span>'+
      '<span class="set-name">'+escapeHTML(s.label)+'</span>'+
      '<span class="set-meta">'+s.data.length+' 词</span>'+
    '</button>'
  ).join('');
  $$('.set-card').forEach(b=>b.addEventListener('click', ()=>{
    if(b.dataset.set === currentSetId) return;
    const s = load(KEY_SESSION);
    if(s && !s.done && !confirm('切换词库会丢弃当前未完成的答题进度，确定继续吗？')) return;
    applySet(b.dataset.set);
  }));
}
$$('.chip').forEach(c=>c.addEventListener('click',()=>setCount(c.dataset.count==='all'?'all':Number(c.dataset.count))));
$('#countInput').addEventListener('input', ()=>{
  config.count = Number($('#countInput').value)||300;
  $$('.chip').forEach(c=>c.classList.remove('on'));
  save(KEY_CFG, config);
});
$$('.mode').forEach(m=>m.addEventListener('click',()=>setMode(m.dataset.mode)));
$('#autoSwitch').addEventListener('click', function(){
  config.autoNext = !config.autoNext;
  this.classList.toggle('on', config.autoNext);
  save(KEY_CFG, config);
});
$('#btnStart').addEventListener('click', startFromSetup);

$('#btnResume').addEventListener('click', ()=>{
  const s = load(KEY_SESSION);
  if(!s || s.done){ checkResume(); return; }
  session = s;
  if(session.mode === 'normal'){
    // 恢复计时：按已记录用时续算
    session.startAt = Date.now() - (session.elapsed||0)*1000;
  }
  enterQuiz();
});
$('#btnDiscard').addEventListener('click', ()=>{
  clearSave(KEY_SESSION);
  $('#resumeBox').classList.add('hidden');
});
$('#btnQuit').addEventListener('click', ()=>{
  if(confirm('结束本次测评并查看当前成绩？已答的题目会保留。')){
    // 未作答的题按未完成处理，只统计已答题
    session.questions = session.questions.slice(0, session.idx+1).filter(q=>q.status);
    if(!session.questions.length){ alert('还没有答过题，先做几题再结束吧。'); return; }
    finishQuiz();
  }
});
$('#btnSpeak').addEventListener('click', ()=>{ if(session && !session.done) speak(current().en); });
$('#btnHint').addEventListener('click', ()=>{ if(session && !session.done){ showHint(); $('#btnHint').textContent='💡 已提示'; $('#btnHint').disabled=true; } });
$('#btnElim').addEventListener('click', eliminateOne);

$('#btnExport').addEventListener('click', exportWrong);
$('#btnBack').addEventListener('click', ()=>{ clearInterval(timerId); show('Setup'); checkResume(); });
$('#btnAgain').addEventListener('click', ()=>{
  const n = session.questions.length, mode = session.mode, auto = session.autoNext;
  startQuiz(buildQuestions(vocab.length?vocab:currentSet().data, n, mode), mode, auto, '重新抽题');
});
$('#btnRedoWrong').addEventListener('click', ()=>{
  const wrongs = session.questions.filter(q=>q.status==='wrong'||q.status==='saved')
    .map(q=>({en:q.en, answer:q.answer, options:shuffle(q.options), status:null, chosen:null, secondChance:false, eliminated:[], hintUsed:false}));
  wrongs.forEach(q=>q.correct = q.options.indexOf(q.answer));
  startQuiz(wrongs, session.mode, session.autoNext, '错题重做');
});

document.addEventListener('keydown', e=>{
  if($('#viewQuiz').classList.contains('hidden')) return;
  if(e.target.tagName === 'TEXTAREA' || e.target.tagName === 'INPUT') return;
  const k = e.key.toLowerCase();
  if(/^[1-4]$/.test(k)) { choose(Number(k)-1); e.preventDefault(); return; }
  if(/^[a-d]$/.test(k)) { choose(k.charCodeAt(0)-97); e.preventDefault(); return; }
  if(k === ' ' || k === 'enter'){
    if($('#feedback').classList.contains('hidden')) return;
    e.preventDefault(); nextQuestion();
  }
});
window.addEventListener('beforeunload', ()=>{ if(session && !session.done) save(KEY_SESSION, session); });

/* ---------- init ---------- */
(function init(){
  const savedCfg = load(KEY_CFG);
  if(savedCfg) config = Object.assign(config, savedCfg);
  $$('.mode').forEach(b=>b.classList.toggle('on', b.dataset.mode===config.mode));
  $('#autoSwitch').classList.toggle('on', config.autoNext);
  $('#setCount').textContent = VOCAB_SETS.length;
  $('#builtinCount').textContent = VOCAB_SETS.reduce((n,s)=>n+s.data.length,0);
  renderSetGrid();
  const savedSet = load(KEY_SET);
  const startSet = VOCAB_SETS.some(s=>s.id===savedSet) ? savedSet : 'ab';
  applySet(startSet);
  $('#countInput').value = config.count === 'all' ? (vocab.length||300) : config.count;
  $$('.chip').forEach(c=>c.classList.toggle('on', c.dataset.count===String(config.count)));
  applyCountLimit();
  checkResume();
})();
</script>
</body>
</html>
